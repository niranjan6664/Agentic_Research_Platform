# ---- Embeddings (local, free) ----
# "sentence-transformers" for real semantic search, "hashing" for a tiny offline fallback (tests/demo)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Chunking / retrieval ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_SCORE=0.15

# ---- Storage ----
UPLOAD_DIR=data/uploads
INDEX_DIR=data/index
MAX_UPLOAD_MB=20

# ---- LLM provider (used from Milestone 2) ----
# ollama (free, local) | openai (paid) | anthropic (paid)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ---- Web search (optional, used from Milestone 2) ----
# none | tavily (paid/free tier) | duckduckgo (free, no key)
SEARCH_PROVIDER=none
TAVILY_API_KEY=your-tavily-key-here
